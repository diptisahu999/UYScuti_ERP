<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plant Report -->
    <record id="action_report_solar_plant" model="ir.actions.report">
        <field name="name">Solar Plant Overview</field>
        <field name="model">solar.plant</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">solar_om.report_solar_plant_template</field>
        <field name="report_file">solar_om.report_solar_plant_template</field>
        <field name="print_report_name">'Plant_Overview_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_solar_plant"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Maintenance Report -->
    <record id="action_report_solar_maintenance" model="ir.actions.report">
