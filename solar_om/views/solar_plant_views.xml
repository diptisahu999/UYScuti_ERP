<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================== -->
    <!-- SOLAR PLANT VIEWS                          -->
    <!-- ========================================== -->

    <!-- Kanban View -->
    <record id="view_solar_plant_kanban" model="ir.ui.view">
        <field name="name">solar.plant.kanban</field>
        <field name="model">solar.plant</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="code"/>
                <field name="capacity"/>
                <field name="customer_id"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_res_partner_kanban oe_semantic_html_override">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    Code: <field name="code"/>
                                </div>
                                <div class="text-muted">
                                    Capacity: <field name="capacity"/> kW
                                </div>
                                <div class="text-muted">
                                    Client: <field name="customer_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_solar_plant_list" model="ir.ui.view">
        <field name="name">solar.plant.list</field>
        <field name="model">solar.plant</field>
        <field name="arch" type="xml">
            <list string="Solar Plants">
                <field name="code"/>
                <field name="name"/>
                <field name="capacity" sum="Total Capacity"/>
                <field name="customer_id"/>
                <field name="manager_id"/>
                <field name="installation_date"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-info="status == 'maintenance'" decoration-warning="status == 'inactive'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_solar_plant_form" model="ir.ui.view">
        <field name="name">solar.plant.form</field>
        <field name="model">solar.plant</field>
        <field name="arch" type="xml">
            <form string="Solar Plant">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,maintenance,inactive" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_maintenance" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" string="Maintenance" widget="statinfo"/>
                        </button>
                        <button name="action_view_cleaning" type="object" class="oe_stat_button" icon="fa-tint">
                            <field name="cleaning_count" string="Cleaning" widget="statinfo"/>
                        </button>
                        <button name="action_view_breakdown" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="breakdown_count" string="Breakdowns" widget="statinfo"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" string="Tasks" widget="statinfo"/>
                        </button>
                        <button name="action_view_generation" type="object" class="oe_stat_button" icon="fa-bolt">
                            <field name="generation_count" string="Generation" widget="statinfo"/>
                        </button>
                        <button name="action_view_sales" type="object" class="oe_stat_button" icon="fa-usd">
                            <field name="sale_order_count" string="Sales" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="code" class="oe_inline"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Plant Name" class="oe_inline"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Basic Details">
                            <field name="capacity"/>
                            <field name="customer_id"/>
                            <field name="discom_name"/>
                            <field name="price_per_unit"/>
                            <field name="installation_date"/>
                            <field name="warranty_expiry_date"/>
                        </group>
                        <group string="Management &amp; Location">
                            <field name="manager_id"/>
                            <field name="engineer_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Equipment" name="equipment">
                            <field name="equipment_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="serial_number"/>
                                    <field name="installation_date"/>
                                    <field name="status" widget="badge" decoration-success="status == 'operational'" decoration-danger="status == 'faulty'" decoration-warning="status == 'maintenance'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Address &amp; Location" name="address">
                            <group>
                                <label for="street" string="Address"/>
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city"/>
                                    <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_quick_create': True}"/>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_solar_plant_search" model="ir.ui.view">
        <field name="name">solar.plant.search</field>
        <field name="model">solar.plant</field>
        <field name="arch" type="xml">
            <search string="Search Solar Plants">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="customer_id"/>
                <field name="manager_id"/>
                
                <separator/>
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Under Maintenance" name="maintenance" domain="[('status', '=', 'maintenance')]"/>
                <filter string="Inactive" name="inactive" domain="[('status', '=', 'inactive')]"/>
                
                <group>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_solar_plant" model="ir.actions.act_window">
        <field name="name">Solar Plants</field>
        <field name="res_model">solar.plant</field>
        <field name="view_mode">list,kanban,form,search</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first solar plant!
            </p>
        </field>
    </record>


    <!-- ========================================== -->
    <!-- MASTER DATA VIEWS                          -->
    <!-- ========================================== -->

    <!-- Equipment Category -->
    <record id="view_solar_equipment_category_list" model="ir.ui.view">
        <field name="name">solar.equipment.category.list</field>
        <field name="model">solar.equipment.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="action_solar_equipment_category" model="ir.actions.act_window">
        <field name="name">Equipment Categories</field>
        <field name="res_model">solar.equipment.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Equipment -->
    <record id="view_solar_equipment_list" model="ir.ui.view">
        <field name="name">solar.equipment.list</field>
        <field name="model">solar.equipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plant_id"/>
                <field name="category_id"/>
                <field name="serial_number"/>
                <field name="installation_date"/>
                <field name="status" widget="badge" decoration-success="status == 'operational'"/>
            </list>
        </field>
    </record>
    <record id="action_solar_equipment" model="ir.actions.act_window">
        <field name="name">Equipments</field>
        <field name="res_model">solar.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Maintenance Type -->
    <record id="view_solar_maintenance_type_list" model="ir.ui.view">
        <field name="name">solar.maintenance.type.list</field>
        <field name="model">solar.maintenance.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="action_solar_maintenance_type" model="ir.actions.act_window">
        <field name="name">Maintenance Types</field>
        <field name="res_model">solar.maintenance.type</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Cleaning Type -->
    <record id="view_solar_cleaning_type_list" model="ir.ui.view">
        <field name="name">solar.cleaning.type.list</field>
        <field name="model">solar.cleaning.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="action_solar_cleaning_type" model="ir.actions.act_window">
        <field name="name">Cleaning Types</field>
        <field name="res_model">solar.cleaning.type</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Checklist Template -->
    <record id="view_solar_checklist_template_form" model="ir.ui.view">
        <field name="name">solar.checklist.template.form</field>
        <field name="model">solar.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Checklist Items" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_solar_checklist_template_list" model="ir.ui.view">
        <field name="name">solar.checklist.template.list</field>
        <field name="model">solar.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="action_solar_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">solar.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Issue Type -->
    <record id="view_solar_issue_type_list" model="ir.ui.view">
        <field name="name">solar.issue.type.list</field>
        <field name="model">solar.issue.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="action_solar_issue_type" model="ir.actions.act_window">
        <field name="name">Issue Types</field>
        <field name="res_model">solar.issue.type</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Priority -->
    <record id="view_solar_priority_list" model="ir.ui.view">
        <field name="name">solar.priority.list</field>
        <field name="model">solar.priority</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_solar_priority" model="ir.actions.act_window">
        <field name="name">Priorities</field>
        <field name="res_model">solar.priority</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Failure Reason -->
    <record id="view_solar_failure_reason_list" model="ir.ui.view">
        <field name="name">solar.failure.reason.list</field>
        <field name="model">solar.failure.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="action_solar_failure_reason" model="ir.actions.act_window">
        <field name="name">Failure Reasons</field>
        <field name="res_model">solar.failure.reason</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Task Stage -->
    <record id="view_solar_task_stage_list" model="ir.ui.view">
        <field name="name">solar.task.stage.list</field>
        <field name="model">solar.task.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_solar_task_stage" model="ir.actions.act_window">
        <field name="name">Task Stages</field>
        <field name="res_model">solar.task.stage</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
