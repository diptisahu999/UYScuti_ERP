<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category -->
    <record id="module_category_solar_om" model="ir.module.category">
        <field name="name">Solar OM</field>
        <field name="description">Solar Operation and Maintenance Management</field>
        <field name="sequence">20</field>
    </record>

    <!-- Privilege definition for Odoo 19 user configuration rendering -->
    <record model="res.groups.privilege" id="res_groups_privilege_solar_om">
        <field name="name">Solar O&amp;M Role</field>
        <field name="category_id" ref="module_category_solar_om"/>
    </record>

    <!-- Groups -->
    <record id="group_solar_om_client" model="res.groups">
        <field name="name">Client</field>
        <field name="privilege_id" ref="res_groups_privilege_solar_om"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_solar_om_engineer" model="res.groups">
        <field name="name">Field Engineer</field>
        <field name="privilege_id" ref="res_groups_privilege_solar_om"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_solar_om_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_solar_om"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_solar_om_manager" model="res.groups">
        <field name="name">O&amp;M Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_solar_om"/>
        <field name="implied_ids" eval="[(4, ref('group_solar_om_project_manager'))]"/>
    </record>

    <record id="group_solar_om_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_solar_om"/>
        <field name="implied_ids" eval="[(4, ref('group_solar_om_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <!-- Client Plant Rule: Client can only read their own plants -->
    <record id="solar_plant_client_rule" model="ir.rule">
        <field name="name">Client: Own Plants Only</field>
        <field name="model_id" ref="model_solar_plant"/>
        <field name="domain_force">[('customer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_client'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Engineer Plant Rule: Engineer can read plants they are assigned to -->
    <record id="solar_plant_engineer_rule" model="ir.rule">
        <field name="name">Engineer: Assigned Plants Only</field>
        <field name="model_id" ref="model_solar_plant"/>
        <field name="domain_force">[('engineer_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_engineer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Manager/PM/Admin Rule: Full access/Read all plants -->
    <record id="solar_plant_all_rule" model="ir.rule">
        <field name="name">Manager/PM/Admin: All Plants</field>
        <field name="model_id" ref="model_solar_plant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_project_manager')), (4, ref('group_solar_om_manager')), (4, ref('group_solar_om_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Task rules for Engineers (Assigned only) -->
    <record id="solar_maintenance_engineer_rule" model="ir.rule">
        <field name="name">Engineer: Assigned Maintenance Only</field>
        <field name="model_id" ref="model_solar_maintenance"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_engineer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="solar_breakdown_engineer_rule" model="ir.rule">
        <field name="name">Engineer: Assigned Breakdown Only</field>
        <field name="model_id" ref="model_solar_breakdown"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_engineer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="solar_cleaning_engineer_rule" model="ir.rule">
        <field name="name">Engineer: Assigned Cleaning Only</field>
        <field name="model_id" ref="model_solar_cleaning"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_engineer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="solar_task_engineer_rule" model="ir.rule">
        <field name="name">Engineer: Assigned Tasks Only</field>
        <field name="model_id" ref="model_solar_task"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_engineer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Task rules for Clients (Own Plant only) -->
    <record id="solar_maintenance_client_rule" model="ir.rule">
        <field name="name">Client: Own Plant Maintenance Only</field>
        <field name="model_id" ref="model_solar_maintenance"/>
        <field name="domain_force">[('plant_id.customer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_client'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="solar_breakdown_client_rule" model="ir.rule">
        <field name="name">Client: Own Plant Breakdown Only</field>
        <field name="model_id" ref="model_solar_breakdown"/>
        <field name="domain_force">[('plant_id.customer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_client'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="solar_cleaning_client_rule" model="ir.rule">
        <field name="name">Client: Own Plant Cleaning Only</field>
        <field name="model_id" ref="model_solar_cleaning"/>
        <field name="domain_force">[('plant_id.customer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_client'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="solar_task_client_rule" model="ir.rule">
        <field name="name">Client: Own Plant Tasks Only</field>
        <field name="model_id" ref="model_solar_task"/>
        <field name="domain_force">[('plant_id.customer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_client'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Manager/PM/Admin Task rules: full access -->
    <record id="solar_maintenance_all_rule" model="ir.rule">
        <field name="name">Manager/PM/Admin: All Maintenance</field>
        <field name="model_id" ref="model_solar_maintenance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_project_manager')), (4, ref('group_solar_om_manager')), (4, ref('group_solar_om_admin'))]"/>
    </record>

    <record id="solar_breakdown_all_rule" model="ir.rule">
        <field name="name">Manager/PM/Admin: All Breakdown</field>
        <field name="model_id" ref="model_solar_breakdown"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_project_manager')), (4, ref('group_solar_om_manager')), (4, ref('group_solar_om_admin'))]"/>
    </record>

    <record id="solar_cleaning_all_rule" model="ir.rule">
        <field name="name">Manager/PM/Admin: All Cleaning</field>
        <field name="model_id" ref="model_solar_cleaning"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_project_manager')), (4, ref('group_solar_om_manager')), (4, ref('group_solar_om_admin'))]"/>
    </record>

    <record id="solar_task_all_rule" model="ir.rule">
        <field name="name">Manager/PM/Admin: All Tasks</field>
        <field name="model_id" ref="model_solar_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_project_manager')), (4, ref('group_solar_om_manager')), (4, ref('group_solar_om_admin'))]"/>
    </record>

    <!-- Daily Generation rules for Clients (Own Plant only) -->
    <record id="solar_daily_generation_client_rule" model="ir.rule">
        <field name="name">Client: Own Plant Daily Generation Only</field>
        <field name="model_id" ref="model_solar_daily_generation"/>
        <field name="domain_force">[('plant_id.customer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_client'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Daily Generation rules for PM/Manager/Admin (All Plants) -->
    <record id="solar_daily_generation_all_rule" model="ir.rule">
        <field name="name">Manager/PM/Admin: All Daily Generation</field>
        <field name="model_id" ref="model_solar_daily_generation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_solar_om_project_manager')), (4, ref('group_solar_om_manager')), (4, ref('group_solar_om_admin'))]"/>
    </record>
</odoo>
