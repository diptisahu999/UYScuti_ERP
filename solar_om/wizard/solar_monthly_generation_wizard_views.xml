<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_solar_monthly_generation_wizard_form" model="ir.ui.view">
        <field name="name">solar.monthly.generation.wizard.form</field>
        <field name="model">solar.monthly.generation.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Monthly Generation Report">
                <group>
                    <group>
                        <field name="plant_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF Report" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_solar_monthly_generation_wizard" model="ir.actions.act_window">
        <field name="name">Monthly Generation Report</field>
        <field name="res_model">solar.monthly.generation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
