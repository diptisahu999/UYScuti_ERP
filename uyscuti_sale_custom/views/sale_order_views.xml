<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Quotation Tree View -->
    <record id="view_quotation_tree_inherit_uyscuti_sale_custom" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.uyscuti_sale_custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="uyscuti_consumer_name" string="Consumer Name"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Sale Order Form View -->
    <record id="view_order_form_inherit_uyscuti_sale_custom" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.uyscuti_sale_custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="uyscuti_consumer_name" string="Consumer Name" readonly="1"/>
                <field name="uyscuti_consumer_id" string="Consumer Number" readonly="1"/>
            </xpath>
            <!-- Restrict Delivery Address to only the selected customer's addresses -->
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="domain">['|', ('id', '=', partner_id), ('parent_id', '=', partner_id)]</attribute>
                <attribute name="no_create">1</attribute>
                <attribute name="no_create_edit">1</attribute>
                <attribute name="no_quick_create">1</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
            <!-- Restrict Invoice Address to only the selected customer's addresses -->
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="domain">['|', ('id', '=', partner_id), ('parent_id', '=', partner_id)]</attribute>
                <attribute name="no_create">1</attribute>
                <attribute name="no_create_edit">1</attribute>
                <attribute name="no_quick_create">1</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
            <!-- Force Inline Creation on Mobile for Order Lines and Show Unit -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="mode">list</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="class">o_list_editable_mobile</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="after">
                <field name="product_uom_id" optional="show" force_save="1"/>
            </xpath>

            <!-- Add Solar Details to Quotation Header -->
            <!-- <xpath expr="//group[@name='order_details']" position="after">
                <group name="solar_pricing" string="Solar Pricing">
                    <group>
                        <field name="solar_kw_capacity" readonly="1" string="Capacity (KW)"/>
                        <field name="solar_sanction_load"/>
                        <field name="solar_sanction_phase"/>
                        <field name="solar_load_phase"/>
                        <field name="solar_discom_id"/>
                    </group>
                    <group>
                        <field name="system_price"/>
                        <field name="discom_fees"/>
                        <field name="mss_price"/>
                    </group>
                    <group>
                        <field name="system_strength_charges"/>
                        <field name="legal_charges"/>
                        <field name="discount"/>
                    </group>
                </group>
            </xpath> -->
        </field>
    </record>
</odoo>
