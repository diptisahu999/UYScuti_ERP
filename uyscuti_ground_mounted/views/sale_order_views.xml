<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_uyscuti_ground_mounted" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.uyscuti.ground_mounted</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Inject is_ground_mounted and opportunity_id as top-level invisible fields so the web client can evaluate them -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_ground_mounted" invisible="1"/>
                <field name="opportunity_id" invisible="1"/>
            </xpath>

            <!-- Override Smart Button from uyscuti_solar_project to trigger python method directly and restrict to this sale order's project -->
            <xpath expr="//button[@name='%(uyscuti_solar_project.action_solar_project)d']" position="attributes">
                <attribute name="name">action_view_solar_project</attribute>
                <attribute name="type">object</attribute>
            </xpath>

            <!-- Add GM Customer Proposal page before the standard order lines page -->
            <xpath expr="//page[@name='order_lines']" position="before">
                <page name="gm_proposal" string="GM Customer Proposal">
                    <group string="Linked Proposal Worksheet">
                        <group col="2">
                            <field name="gm_proposal_id" 
                                   domain="[('lead_id', '=', opportunity_id)]" 
                                   context="{'default_lead_id': opportunity_id, 'default_partner_id': partner_id, 'default_customer_name': partner_id.name or '', 'default_customer_mobile': partner_id.phone or ''}"/>
                            <field name="is_ground_mounted" invisible="1"/>
                        </group>
                    </group>

                    <!-- Embed proposal summary -->
                    <group string="Proposal Sizing &amp; Financial Summary" invisible="not gm_proposal_id">
                        <group>
                            <field name="gm_proposal_capacity_mw" readonly="1"/>
                            <field name="gm_proposal_total_cost" readonly="1"/>
                        </group>
                        <group>
                            <field name="gm_proposal_yearly_emi" readonly="1"/>
                            <field name="gm_proposal_net_losses" string="Net Losses (%)" readonly="1"/>
                        </group>
                    </group>

                    <!-- Projections notebook tab -->
                    <notebook name="gm_quotation_projections_notebook" invisible="not gm_proposal_id">
                        <page name="projections" string="25-Year Profitability Cash-Flow Matrix">
                            <field name="gm_proposal_line_ids" readonly="1">
                                <list create="0" delete="0" edit="0" string="Projection Lines">
                                    <field name="year"/>
                                    <field name="received_units" string="Received Units"/>
                                    <field name="rate_kwh" string="Rate/kWh"/>
                                    <field name="yearly_revenue" string="Yly. Revenue (Lakh)"/>
                                    <field name="grid_expenses" string="Grid Expenses (Lakh)"/>
                                    <field name="om_expenses" string="O&amp;M Exp (Lakh)"/>
                                    <field name="land_lease" string="Land Lease (Lakh)"/>
                                    <field name="emi" string="EMI (Lakh)"/>
                                    <field name="net_income" string="Net Income (Lakh)"/>
                                    <field name="gst_input_credit" string="GST Credit (Lakh)"/>
                                    <field name="cumulative_income" string="Cumulative Income (Lakh)" class="font-weight-bold text-success"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
