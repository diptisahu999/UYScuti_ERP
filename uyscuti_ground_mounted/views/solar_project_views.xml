                                        context="{'field_name': 'gm_discom_agreement_doc'}" invisible="not gm_discom_agreement_doc" class="btn-link p-0"/>
                                <field name="gm_discom_agreement_doc_name" invisible="1"/>
                            </div>
                        </group>
                    </group>
                    <group col="2">
                        <group string="8. Land">
                            <field name="gm_land_area_acres" readonly="1"/>
                            <field name="gm_land_clearance_date" readonly="1"/>
                            <field name="gm_land_survey_no" readonly="1"/>
                            <label for="gm_land_document"/>
                            <div class="o_row">
                                <field name="gm_land_document" readonly="1" filename="gm_land_document_name"/>
                                <button name="action_preview_document" string="Preview" type="object" icon="fa-eye"
                                        context="{'field_name': 'gm_land_document'}" invisible="not gm_land_document" class="btn-link p-0"/>
                                <field name="gm_land_document_name" invisible="1"/>
                            </div>
                        </group>
                        <group string="9. Design">
                            <field name="gm_design_date" readonly="1"/>
                            <field name="gm_design_approved_by" readonly="1"/>
