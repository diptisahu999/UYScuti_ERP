                            <field name="gm_qc_report_name" invisible="1"/>
                        </div>
                    </group>
                </group>
            </xpath>

            <!-- Add Ground Mounted history page -->
            <xpath expr="//page[@name='payments']" position="after">
                <page name="gm_documentation" string="Project History &amp; Docs" invisible="project_type not in ('ground_mounted', 'commercial')">
                    <group string="Ground Mounted Project Milestones History">
                        <group string="LOA Documents" colspan="2">
                            <field name="loa_line_ids" readonly="1">
                                <list>
                                    <field name="file" filename="file_name"/>
                                    <field name="file_name" column_invisible="True"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </group>
                        <group string="1. Project Apply" colspan="2">
                            <field name="gm_project_apply_date" readonly="1"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="2. Discom Application">
                            <field name="gm_discom_app_date" readonly="1"/>
                        </group>
                        <group string="3. Akshay Urja Connectivity Apply">
                            <field name="gm_akshay_urja_date" readonly="1"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="4. Document Submit">
                            <field name="gm_doc_submit_date" readonly="1"/>
                        </group>
                        <group string="5. Fees Payment">
                            <field name="gm_fees_pay_date" readonly="1"/>
                            <field name="gm_fees_amount" readonly="1"/>
                            <label for="gm_fees_receipt"/>
                            <div class="o_row">
                                <field name="gm_fees_receipt" readonly="1" filename="gm_fees_receipt_name"/>
