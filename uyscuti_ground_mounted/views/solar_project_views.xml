                        <div class="o_row">
                            <field name="gm_tasklist_doc" filename="gm_tasklist_doc_name"/>
                            <button name="action_preview_document" string="Preview" type="object" icon="fa-eye"
                                    context="{'field_name': 'gm_tasklist_doc'}" invisible="not gm_tasklist_doc" class="btn-link p-0"/>
                            <field name="gm_tasklist_doc_name" invisible="1"/>
                        </div>
                    </group>
                </group>

                <!-- GM 18. QC -->
                <group invisible="state != 'gm_qc'">
                    <group string="18. Final QC Inspection &amp; Closeout">
                        <field name="gm_qc_date"/>
                        <field name="gm_qc_status"/>
                        <field name="gm_qc_inspector"/>
                        <label for="gm_qc_report"/>
                        <div class="o_row">
                            <field name="gm_qc_report" filename="gm_qc_report_name"/>
                            <button name="action_preview_document" string="Preview" type="object" icon="fa-eye"
