<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Solar Project Form View -->
        <record id="view_solar_project_form" model="ir.ui.view">
            <field name="name">solar.project.form</field>
            <field name="model">solar.project</field>
            <field name="arch" type="xml">
                <form string="Solar Project">
                    <header>
                        <field name="is_stage_editable" invisible="1"/>
                        <button name="action_next_stage" string="Move to Next Stage" type="object" class="btn-primary" 
                                invisible="state == 'payment_clear' or not is_stage_editable"/>
                        <button name="action_previous_stage" string="Move to Previous Stage" type="object" class="btn-primary" 
                                invisible="state == 'loa' or not is_stage_editable"/>
                        <field name="state" widget="statusbar" statusbar_visible="loa,gm_project_apply,gm_discom_agreement,gm_land,gm_design,gm_bom,gm_vendor_select,gm_store_incharge,gm_authorised_person,gm_mms_report,gm_blockwise_reconcile,gm_tasklist,gm_qc"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_financials" type="object" class="oe_stat_button" icon="fa-calculator">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value"><field name="financial_count"/></span>
                                    <span class="o_stat_text">Financials</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Project ID"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <div class="row bg-light p-3 mb-3 border rounded shadow-sm">
                            <div class="col-md-4">
                                <strong>Consumer Name : </strong> <field name="partner_id" readonly="1"/><br/>
                                <strong>Consumer No : </strong> <field name="consumer_no" readonly="1"/>
                            </div>
                            <div class="col-md-4">
                                <strong>Type : </strong> <field name="project_type"/><br/>
                                <strong>Date : </strong> <field name="date_start"/>
                            </div>
                            <div class="col-md-4">
                                <strong>Capacity : </strong> <field name="kw_capacity" readonly="1"/> KW<br/>
                                <strong>MO : </strong> <field name="mobile" readonly="1"/><br/>
                                <strong>Can Edit This Stage : </strong> <field name="is_stage_editable" widget="boolean_toggle"/>
                            </div>
                        </div>
                        <notebook readonly="not is_stage_editable">
                            <page name="current_stage" string="Current Stage Detail">
                                <!-- 1. LOA (Letter of Acceptance) -->
                                <div invisible="state != 'loa'">
                                    <separator string="1. LOA (Letter of Acceptance) Documents"/>
                                    <field name="loa_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="file" filename="file_name"/>
                                            <field name="file_name" column_invisible="True"/>
                                            <field name="description"/>
                                        </list>
                                    </field>
                                </div>
                            </page>

                            <page name="payments" string="Payments &amp; Installments">
                                <group name="payment_final" string="Payment Entries &amp; Settlements">
                                    <field name="payment_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="date"/>
                                            <field name="amount" sum="Total"/>
                                            <field name="remark"/>
                                        </list>
                                    </field>
                                    <group class="oe_subtotal_footer">
                                        <field name="payment_total" string="Total Amount Paid" widget="monetary" decoration-bf="1" decoration-success="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Project List View -->
        <record id="view_solar_project_tree" model="ir.ui.view">
            <field name="name">solar.project.tree</field>
            <field name="model">solar.project</field>
            <field name="arch" type="xml">
                <list string="Solar Projects" decoration-success="state == 'payment_clear'">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="kw_capacity" sum="Total Capacity"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_solar_project_search" model="ir.ui.view">
            <field name="name">solar.project.search</field>
            <field name="model">solar.project</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="consumer_no"/>
                    <filter name="my_projects" string="My Projects" domain="[('user_id', '=', uid)]"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_solar_project" model="ir.actions.act_window">
            <field name="name">Solar Projects</field>
            <field name="res_model">solar.project</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_solar_project_search"/>
        </record>

        <!-- Smart Button on Sale Order -->
        <record id="view_order_form_inherit_solar_project" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.solar.project</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="%(action_solar_project)d" type="action" class="oe_stat_button" icon="fa-sun-o" invisible="not solar_project_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Solar Project</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_solar_project_root" name="Solar Projects" parent="sale.sale_menu_root" action="action_solar_project" sequence="20"/>
    </data>
</odoo>
